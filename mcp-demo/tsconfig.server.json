{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist-server",
    "types": ["node"]
  },
  "include": ["server/src/**/*.ts", "shared/**/*.ts"],
  "exclude": [
    "server/src/**/*.test.ts",
    "server/src/**/*.dbtest.ts",
    "server/src/testdb.ts",
    "server/src/dbtest.setup.ts",
    "shared/**/*.test.ts"
  ]
}
