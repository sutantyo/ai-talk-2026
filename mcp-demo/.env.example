# Copy to .env for local runs. On Railway these are service variables (there is no .env there).

# Postgres connection string. Railway sets it when a Postgres database is attached.
# Leave empty locally: the server then uses PGlite (Postgres inside Node), stored in .data/.
DATABASE_URL=

# 32+ random characters; signs session cookies and access tokens. Changing it signs everyone out
# and disconnects Claude. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Google OAuth "Web application" client id (Google Cloud console). Public, not a secret.
# Add the site's origin under "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=

# Comma-separated Google accounts allowed to sign in. Empty means ANY Google account: don't deploy that way.
ALLOWED_EMAILS=

# "true" when deployed (HTTPS), "false" for local http.
SECURE_COOKIES=

# Where this server is reached, no trailing slash. The Claude connector URL is this + /mcp, exactly.
#   https://<your-app>.up.railway.app     (deployed)
#   http://localhost:8080                 (local)
PUBLIC_BASE_URL=

# Local testing only: lets the page sign in as this email without Google.
# The server refuses to start with it unless PUBLIC_BASE_URL is http://localhost.
DEV_LOGIN_EMAIL=
